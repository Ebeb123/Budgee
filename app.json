{
  "expo": {
    "name": "Budgee",
    "slug": "expense-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "budgee",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.local.budgee",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E121C"
      }
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0E121C",
            "image": "./assets/splash-mark.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5A9216",
          "defaultChannel": "bills"
        }
      ],
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Budgee uses your photos only when you pick a logo for a biller.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3884eed2-361c-407a-b0ad-99acae105c6b"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Budgee — Expense Tracker"
    }
  }
}
